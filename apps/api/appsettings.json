{
  "AllowedHosts": "localhost;127.0.0.1",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=yanyun;Username=yanyun;Timeout=3;Command Timeout=5",
    "Redis": "localhost:6379"
  },
  "Auth": {
    "Issuer": "yanyun-api",
    "Audience": "yanyun-web",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "Redis": {
    "KeyPrefix": "yanyun:development:",
    "ConnectTimeoutMilliseconds": 2000,
    "OperationTimeoutMilliseconds": 2000
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  }
}
