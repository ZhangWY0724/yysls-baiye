# 复制为 docker/.env 后填写，不提交真实凭证。
POSTGRES_DB=yanyun
POSTGRES_USER=yanyun
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SIGNING_KEY=
RESEND_API_KEY=
EMAIL_FROM=百业平台 <noreply@io724.fun>
PUBLIC_ORIGIN=https://你的前端域名

# --- 生产部署（compose.server.yml 的 api / web）追加 ---
PUBLIC_HOST=你的域名（不含协议，例如 yy.example.com）
# Redis 键前缀；与本机开发共用同一个 Redis 时，请使用不同前缀隔离
REDIS_KEY_PREFIX=yanyun:prod:
# compose 网络网关地址，首次 up 后执行：
# docker network inspect yanyun-infrastructure_default -f '{{(index .IPAM.Config 0).Gateway}}'
PROXY_IP=172.18.0.1
